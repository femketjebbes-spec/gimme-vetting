{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Handover Payload",
  "description": "Schema for agent handover payloads submitted for Alignment Agent review",
  "type": "object",
  "required": ["agentName", "timestamp", "artefactType", "content", "complianceChecklist"],
  "properties": {
    "agentName": {
      "type": "string",
      "description": "Name of the agent submitting the payload",
      "enum": ["Femke", "Naut", "Gerard", "Archibald", "Robbie", "Database Engineer", "Ada"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of submission"
    },
    "artefactType": {
      "type": "string",
      "description": "Type of artefact being handed over",
      "enum": ["api-contract", "frontend-code", "backend-code", "delegation-plan", "requirements", "agent-definition", "architecture-decision", "test-coverage"]
    },
    "content": {
      "type": "object",
      "description": "The artefact content or a reference to it"
    },
    "complianceChecklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "passed"],
        "properties": {
          "check": {
            "type": "string",
            "description": "Description of the compliance check performed"
          },
          "passed": {
            "type": "boolean",
            "description": "Whether the check passed"
          }
        }
      },
      "description": "Self-compliance checklist completed by the submitting agent"
    }
  }
}
