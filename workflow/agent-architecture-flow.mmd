    style ReviewChannel fill:#ff9,stroke:#333,stroke-width:2px
    style FinalArtefacts fill:#9f9,stroke:#333,stroke-width:2px
    style VersionedReadySignal fill:#9cf,stroke:#333,stroke-width:2px
    style ApiContractVersioned fill:#9cf,stroke:#333,stroke-width:2px
