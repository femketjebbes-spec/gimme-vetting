flowchart TD
    %% Nodes
    Start([● Start: Invoice Received])
    Dec1{Sufficient info for<br>identifyability of debtor?}
    Act1[Auto-complete debtor info]
    Dec2{Debtor identified?}
    EndDossier(((⦿ Invoice to dossier)))
    EndReject(((⦿ Rejection type A<br>Sent back to client)))

    %% Styling (Kleurenschema voor optimale UML-leesbaarheid)
    style Start fill:#000000,stroke:#333333,stroke-width:2px,color:#ffffff
    style Dec1 fill:#33b5e5,stroke:#1a90b8,stroke-width:2px,color:#ffffff
    style Act1 fill:#ff9900,stroke:#d47b00,stroke-width:2px,color:#ffffff
    style Dec2 fill:#33b5e5,stroke:#1a90b8,stroke-width:2px,color:#ffffff
    style EndDossier fill:#333333,stroke:#000000,stroke-width:2px,color:#ffffff
    style EndReject fill:#ff4444,stroke:#cc0000,stroke-width:2px,color:#ffffff

    %% Connections met gecorrigeerde logica en guards
    Start --> Dec1
    Dec1 -->|Yes| EndDossier
    Dec1 -->|No| Act1
    Act1 --> Dec2
    Dec2 -->|Yes| EndDossier
    Dec2 -->|No| EndReject
